<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- ML Kit's transitive library declares INTERNET. Model installation uses
         the separate Google Play services process; our app handles photo
         data only on-device. Enforce no app network permission at build. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove"/>
    <uses-feature android:name="android.software.live_wallpaper" android:required="false"/>
    <application android:label="Motion Wall Cars" android:allowBackup="false"
        android:theme="@style/AppTheme" android:usesCleartextTraffic="false">
        <!-- Free local foreground separation; Google Play services downloads
             the model once and inference then happens on this device. -->
        <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="subject_segment"/>
        <activity android:name=".MainActivity" android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service android:name=".MotionWallpaperService" android:exported="true"
            android:label="Night Ride" android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService"/>
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper"/>
        </service>
        <!-- Video wallpaper from a real decoded MP4; no camera animation fake. -->
        <service android:name=".MotionVideoWallpaperService" android:exported="true"
            android:label="Motion Wall · Видеодвижение"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService"/>
            </intent-filter>
            <meta-data android:name="android.service.wallpaper" android:resource="@xml/wallpaper"/>
        </service>
    </application>
</manifest>
